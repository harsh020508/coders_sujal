# Supabase Configuration
# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Node Server (Local Development Only)
PORT=3000

# AI Photo Diagnosis (Gemini Vision) — server-only. Never prefix with VITE_.
# Used by POST /api/analyze-photo (server.js locally, api/analyze-photo.js on Vercel).
# GEMINI_API_KEYS = comma-separated rotation list (first working key wins).
# On Vercel these must ALSO be set in: Project > Settings > Environment Variables
# (.env files are gitignored and are NOT uploaded to Vercel production).
GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY=key1
GEMINI_MODEL=gemini-3.5-flash
DEMO_MODE=false

# LocalKaam Care (AI) — server-only OpenRouter keys. Never prefix with VITE_.
# Comma-separated list = key rotation list. First working key wins; on
# 401/402/429/5xx the request rotates to the next key.
OPENROUTER_API_KEYS=key1,key2,key3
OPENROUTER_MODEL=openai/gpt-4o-mini

# Booking arrival OTP: in-app only (Uber/Ola-style). The customer sees the
# 6-digit code in the app when they book and shares it verbally when the
# worker reaches home. No SMS/phone OTP, so no Twilio keys are needed.
